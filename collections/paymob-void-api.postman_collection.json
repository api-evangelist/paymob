  "info": {
    "_postman_id": "d4d89d60-5b3b-426c-a869-8771e9d01197",
    "name": "Paymob Accept Legacy (v2) Accounts Void API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The legacy Paymob Accept API uses a three-step flow: authenticate to receive a bearer auth_token, register an order, then request a payment_key. The payment_key is used either with the iframe redirect or the headless /payments/pay endpoint. Refund, void, capture, transaction inquiry, and saved-card MOTO operations are exposed on this surface.\n\nContact Support:\n Name: Paymob Developers",
      "type": "text/plain"
    }
  }
