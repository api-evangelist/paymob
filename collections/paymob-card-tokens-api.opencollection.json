{
  "opencollection": "1.0.0",
  "info": {
    "name": "Paymob Accept Legacy (v2) Accounts Card Tokens API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Card Tokens",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Card Tokens",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://accept.paymob.com/api/acceptance/card_tokens"
          },
          "docs": "List Card Tokens"
        },
        {
          "info": {
            "name": "Delete Card Token",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://accept.paymob.com/api/acceptance/card_tokens/:token_id",
            "params": [
              {
                "name": "token_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete Card Token"
        }
      ]
    }
  ],
  "bundled": true
}