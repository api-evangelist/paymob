{
  "opencollection": "1.0.0",
  "info": {
    "name": "Paymob Accept Legacy (v2) Accounts Authentication API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Authenticate Merchant",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://accept.paymob.com/api/auth/tokens",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Exchange the merchant API key for a short-lived auth_token (60 minutes)."
        },
        {
          "info": {
            "name": "Generate Access Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://accept.paymob.com/api/auth/token/",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "grant_type",
                  "value": ""
                },
                {
                  "name": "username",
                  "value": ""
                },
                {
                  "name": "password",
                  "value": ""
                },
                {
                  "name": "client_id",
                  "value": ""
                },
                {
                  "name": "client_secret",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Generate an OAuth2 access token. Token must be refreshed every 60 minutes."
        },
        {
          "info": {
            "name": "Refresh Access Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://accept.paymob.com/api/auth/token/refresh/",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "grant_type",
                  "value": ""
                },
                {
                  "name": "refresh_token",
                  "value": ""
                },
                {
                  "name": "client_id",
                  "value": ""
                },
                {
                  "name": "client_secret",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Refresh Access Token"
        }
      ]
    }
  ],
  "bundled": true
}