  "info": {
    "_postman_id": "addc948b-ef6a-44cb-bfc1-6daf659208cc",
    "name": "Paymob Accept Legacy (v2) Accounts Subscriptions API",
    "description": "The legacy Paymob Accept API uses a three-step flow: authenticate to receive a bearer auth_token, register an order, then request a payment_key. The payment_key is used either with the iframe redirect or the headless /payments/pay endpoint. Refund, void, capture, transaction inquiry, and saved-card MOTO operations are exposed on this surface.\n\nContact Support:\n Name: Paymob Developers",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T02:32:49.000Z",
